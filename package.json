{
  "name": "mini-image-editor",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "author": "Mateus Salvi (https://github.com/salvimateus)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle -- --locked",
    "build:linux": "tauri build --bundles deb -- --locked",
    "release": "node scripts/make-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "@lucide/svelte": "1.63.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "fast-png": "8.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "rolldown": "1.2.15",
    "@rolldown/pluginutils": "1.0.1",
    "tslib": "2.8.1",
    "wasm-feature-detect": "1.9.0"
  }
}
